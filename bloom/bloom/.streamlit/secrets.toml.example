# Copy to .streamlit/secrets.toml (git-ignored) and fill in.
# Top-level values are also exposed to the app as environment variables.
SERVICE_KEY = ""          # must equal SERVICE_KEY on the API
API_URL = "http://localhost:8000"

[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = ""        # python -c "import secrets; print(secrets.token_hex(32))"
client_id = ""            # from Google Cloud Console
client_secret = ""
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
